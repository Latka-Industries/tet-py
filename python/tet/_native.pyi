from pathlib import Path
from typing import Any

import numpy as np

__version__: str

class TetError(Exception): ...
class CatalogError(Exception): ...

class TetFile:
    @property
    def path(self) -> str: ...
    @property
    def generation(self) -> int | None: ...
    def datasets(self) -> list[str]: ...
    def summary_json(self) -> str: ...
    def query(self, query: Any, preview_max: int | None = None) -> str: ...
    """Execute; ``query`` may be dict, JSON string, or TOML string (Auto detect)."""
    def plan_only(self, query: Any) -> str: ...
    """Plan only; same query document shapes as :meth:`query`."""
    def read_numpy(self, query: Any) -> np.ndarray: ...
    def transform_to_numpy(self, query: Any) -> np.ndarray: ...

class MemoryStore:
    def __init__(self) -> None: ...
    @classmethod
    def from_package(cls, path: Path) -> MemoryStore: ...
    def ingest(self, source: Path, *, session_id: str, part_id: str) -> str: ...
    def publish(self, part_ids: list[str], *, generation: int | None = None) -> int: ...
    def seal(self, part_ids: list[str], generation: int) -> int: ...
    def cas_publish(self, generation: int, *, expected: int | None) -> None: ...
    def open(self, uri: str = "memory://current") -> TetFile: ...

class S3Store:
    @classmethod
    def connect(
        cls,
        *,
        endpoint: str,
        bucket: str,
        access_key_id: str,
        secret_access_key: str,
        prefix: str = "",
        region: str = "us-east-1",
    ) -> S3Store: ...
    def ingest(self, source: Path, *, session_id: str, part_id: str) -> str: ...
    def publish(self, part_ids: list[str], *, generation: int | None = None) -> int: ...
    def seal(self, part_ids: list[str], generation: int) -> int: ...
    def cas_publish(self, generation: int, *, expected: int | None) -> None: ...
    def open(self, pin: str = "current") -> TetFile: ...

class WriteDatasetOptions:
    def __init__(self) -> None: ...
    chunk_shape: tuple[int, ...] | None
    attrs: dict[str, str] | None
    dim_names: list[str] | None
    coords: dict[str, list[str]] | None

class TetWriterSession:
    @staticmethod
    def create(path: Path) -> TetWriterSession: ...
    @staticmethod
    def open_append(path: Path) -> TetWriterSession: ...
    @property
    def path(self) -> str: ...
    @property
    def dataset_count(self) -> int: ...
    def write_dataset(
        self,
        name: str,
        array: np.ndarray,
        options: WriteDatasetOptions | None = None,
    ) -> None: ...
    def push_history_event(self, op: str, source: str) -> None: ...
    def commit(self) -> str: ...

def open(path: Path) -> TetFile: ...
def open_package(path: Path) -> TetFile: ...
def open_uri(uri: str) -> TetFile: ...
def download_s3_object(bucket: str, key: str) -> bytes: ...
def upload_s3_object(bucket: str, key: str, body: bytes) -> None: ...
def list_s3_prefix(bucket: str, prefix: str) -> list[str]: ...
def package_create(path: Path) -> None: ...
def part_id_from_path(path: Path) -> str: ...
def package_ingest(package: Path, source: Path, session_id: str, part_id: str) -> str: ...
def package_publish(
    package: Path,
    generation: int | None,
    part_ids: list[str],
    *,
    dry_run: bool = False,
    replace: list[str] | None = None,
) -> int: ...
def package_pack(
    package: Path,
    dest: Path,
    generation: int | None = None,
    remove_package: bool = False,
) -> int: ...
def core_version() -> str: ...
